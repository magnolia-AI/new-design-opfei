{
  "id": "screen-desktop-1",
  "name": "Desktop",
  "width": 1440,
  "height": 900,
  "root": {
    "id": "root-1",
    "type": "frame",
    "name": "Root",
    "className": "w-full min-h-screen bg-background text-foreground font-sans flex flex-col items-center",
    "children": [
      {
        "id": "navbar",
        "type": "frame",
        "name": "Navbar",
        "className": "w-full max-w-7xl h-20 flex items-center justify-between px-8 py-4 border-b border-border sticky top-0 bg-background/80 backdrop-blur-md z-50",
        "children": [
          {
            "id": "logo-container",
            "type": "frame",
            "name": "Logo container",
            "className": "flex items-center gap-2",
            "children": [
              {
                "id": "logo-icon",
                "type": "icon",
                "props": { "name": "Zap" },
                "className": "text-primary w-8 h-8"
              },
              {
                "id": "logo-text",
                "type": "text",
                "text": "BOOTSUSHIV1",
                "className": "text-2xl font-bold tracking-tighter"
              }
            ]
          },
          {
            "id": "nav-links",
            "type": "frame",
            "name": "Nav Links",
            "className": "hidden md:flex items-center gap-8 text-sm font-medium",
            "children": [
              { "id": "nav-item-1", "type": "text", "text": "Platform", "className": "hover:text-primary cursor-pointer transition-colors" },
              { "id": "nav-item-2", "type": "text", "text": "Engine", "className": "hover:text-primary cursor-pointer transition-colors" },
              { "id": "nav-item-3", "type": "text", "text": "Pricing", "className": "hover:text-primary cursor-pointer transition-colors" }
            ]
          },
          {
            "id": "nav-actions",
            "type": "frame",
            "name": "Nav Actions",
            "className": "flex items-center gap-4",
            "children": [
              { "id": "btn-login", "type": "button", "text": "Enter", "props": { "variant": "ghost" } },
              {
                "id": "btn-signup",
                "type": "button",
                "text": "Launch Now",
                "props": { "variant": "default" },
                "className": "bg-primary text-primary-foreground font-bold rounded-none px-6 shadow-[4px_4px_0px_0px_#D9F99D]"
              }
            ]
          }
        ]
      },
      {
        "id": "hero-section",
        "type": "frame",
        "name": "Hero Section",
        "className": "w-full max-w-7xl px-8 py-32 flex flex-col items-center text-center",
        "children": [
          {
            "id": "hero-badge",
            "type": "badge",
            "text": "V2.0 RELEASE: TURBO GRIDS ARE HERE",
            "props": { "variant": "secondary" },
            "className": "mb-10 bg-secondary/30 text-secondary-foreground border border-secondary font-mono italic px-4 py-1"
          },
          {
            "id": "hero-h1",
            "type": "text",
            "text": "Build Professional Apps with Street Velocity.",
            "className": "text-8xl font-black tracking-tighter max-w-5xl mb-8 leading-[0.9] uppercase"
          },
          {
            "id": "hero-desc",
            "type": "text",
            "text": "The developer-first platform that merges Tokyo's obsessive precision with Mexico City's soul. Ship code that vibrates with energy.",
            "className": "text-xl text-muted-foreground max-w-2xl mb-12 font-mono"
          },
          {
            "id": "hero-ctas",
            "type": "frame",
            "name": "CTAs",
            "className": "flex gap-6",
            "children": [
              {
                "id": "cta-main",
                "type": "button",
                "text": "Deploy Your Core",
                "props": { "size": "lg" },
                "className": "bg-primary text-primary-foreground h-16 px-12 text-xl rounded-none font-bold shadow-[10px_10px_0px_0px_#D9F99D] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[12px_12px_0px_0px_#D9F99D] transition-all"
              },
              {
                "id": "cta-sub",
                "type": "button",
                "text": "Documentation",
                "props": { "variant": "outline", "size": "lg" },
                "className": "h-16 px-12 text-xl rounded-none border-4 border-foreground hover:bg-foreground hover:text-background font-bold transition-all"
              }
            ]
          }
        ]
      },
      {
        "id": "feature-section",
        "type": "frame",
        "name": "Features",
        "className": "w-full max-w-7xl px-8 py-24 grid grid-cols-1 lg:grid-cols-3 gap-12",
        "children": [
          {
            "id": "card-1",
            "type": "card",
            "className": "rounded-none border-4 border-foreground bg-card p-4 shadow-[8px_8px_0px_0px_#67E8F9]",
            "children": [
              {
                "id": "card-1-content",
                "type": "frame",
                "name": "Card Content",
                "className": "space-y-4",
                "children": [
                  { "id": "c1-icon", "type": "icon", "props": { "name": "Box" }, "className": "w-12 h-12 text-accent" },
                  { "id": "c1-title", "type": "text", "text": "Precision Modules", "className": "text-3xl font-bold uppercase" },
                  { "id": "c1-text", "type": "text", "text": "Bento-style architecture for scalable components. Organized, clean, and terrifyingly efficient.", "className": "text-muted-foreground font-mono" }
                ]
              }
            ]
          },
          {
            "id": "card-2",
            "type": "card",
            "className": "rounded-none border-4 border-foreground bg-card p-4 shadow-[8px_8px_0px_0px_#E11D48]",
            "children": [
              {
                "id": "card-2-content",
                "type": "frame",
                "name": "Card Content",
                "className": "space-y-4",
                "children": [
                  { "id": "c2-icon", "type": "icon", "props": { "name": "Zap" }, "className": "w-12 h-12 text-primary" },
                  { "id": "c2-title", "type": "text", "text": "Neon Latency", "className": "text-3xl font-bold uppercase" },
                  { "id": "c2-text", "type": "text", "text": "Under 50ms edge propagation. Faster than a heartbeat, more reliable than sunrise.", "className": "text-muted-foreground font-mono" }
                ]
              }
            ]
          },
          {
            "id": "card-3",
            "type": "card",
            "className": "rounded-none border-4 border-foreground bg-card p-4 shadow-[8px_8px_0px_0px_#D9F99D]",
            "children": [
              {
                "id": "card-3-content",
                "type": "frame",
                "name": "Card Content",
                "className": "space-y-4",
                "children": [
                  { "id": "c3-icon", "type": "icon", "props": { "name": "Cpu" }, "className": "w-12 h-12 text-secondary" },
                  { "id": "c3-title", "type": "text", "text": "Street Engine", "className": "text-3xl font-bold uppercase" },
                  { "id": "c3-text", "type": "text", "text": "Rugged, battle-tested compute nodes designed to handle explosive traffic surges.", "className": "text-muted-foreground font-mono" }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "footer-block",
        "type": "frame",
        "name": "Footer",
        "className": "w-full border-t-8 border-foreground py-16 px-8 mt-24 bg-card",
        "children": [
          {
            "id": "f-inner",
            "type": "frame",
            "name": "Footer Inner",
            "className": "max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-10",
            "children": [
              {
                "id": "f-left",
                "type": "frame",
                "name": "Footer Left",
                "className": "space-y-4",
                "children": [
                  { "id": "f-logo", "type": "text", "text": "BOOTSUSHIV1", "className": "text-4xl font-black italic" },
                  { "id": "f-copy", "type": "text", "text": "Surgical Precision. Street Soul. © 2026", "className": "text-sm font-mono uppercase tracking-widest" }
                ]
              },
              {
                "id": "f-right",
                "type": "frame",
                "name": "Footer Right",
                "className": "flex gap-12",
                "children": [
                  { "id": "fl-1", "type": "text", "text": "DOCS", "className": "font-bold underline decoration-primary decoration-4 underline-offset-4 cursor-pointer" },
                  { "id": "fl-2", "type": "text", "text": "GITHUB", "className": "font-bold underline decoration-accent decoration-4 underline-offset-4 cursor-pointer" },
                  { "id": "fl-3", "type": "text", "text": "STATUS", "className": "font-bold underline decoration-secondary decoration-4 underline-offset-4 cursor-pointer" }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}